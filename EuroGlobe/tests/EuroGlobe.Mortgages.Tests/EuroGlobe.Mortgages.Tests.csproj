<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Coverage gate (coverlet.msbuild): `dotnet test EuroGlobe.slnx /p:CollectCoverage=true` fails below 70 % line or branch. -->
  <PropertyGroup>
    <Include>[EuroGlobe.Mortgages]*,[EuroGlobe.Api]EuroGlobe.Api.Controllers.Mortgages.*</Include>
    <Exclude>[*]*.Migrations.*</Exclude>
    <Threshold>70</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EuroGlobe.Mortgages\EuroGlobe.Mortgages.csproj" />
    <ProjectReference Include="..\..\src\EuroGlobe.Api\EuroGlobe.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
